{
  "name": "@seam/dsh-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/plugin.js", "./engine": "./dist/engine.js" },
  "scripts": {
    "build": "tsc && node scripts/build-compiled-runtime.mjs",
    "pretest": "node scripts/build-compiled-runtime.mjs",
    "audit": "tsx scripts/audit-workflows.ts",
    "compile:workflow": "tsx scripts/compile-workflow.ts",
    "link:dsh": "node scripts/link-dsh.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-workflow": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-brand": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-workflow": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
