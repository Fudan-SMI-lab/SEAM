{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0",
  "title": "Phase 6: Reports Output",
  "type": "object",
  "properties": {
    "report_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migration_summary": {
      "type": "object",
      "properties": {
        "files_migrated": {
          "type": "integer"
        },
        "files_skipped": {
          "type": "integer"
        }
      },
      "required": ["files_migrated", "files_skipped"]
    },
    "run_timeline": {
      "type": "object",
      "properties": {
        "run_started_at": {
          "type": "string"
        },
        "run_ended_at": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "started_at": {
                "type": "string"
              },
              "ended_at": {
                "type": "string"
              },
              "duration_seconds": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "required": ["report_paths", "migration_summary"]
}
